{
  "name": "@harbard/desktop",
  "version": "0.3.0-alpha.9",
  "private": true,
  "description": "Tauri shell around the fleet console — tray, notifications, summon shortcut",
  "scripts": {
    "dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "build": "bunx --bun @tauri-apps/cli build --bundles app",
    "install:app": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
