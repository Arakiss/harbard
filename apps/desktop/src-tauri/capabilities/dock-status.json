{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dock-status",
  "description": "Only the main window reports the living logo's state to the Dock",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:3419",
      "http://127.0.0.1:3419/*"
    ]
  },
  "permissions": ["allow-desk-set-status"]
}
