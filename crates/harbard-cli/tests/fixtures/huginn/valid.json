    },
    "c": {
     "type": "CheckboxField",
     "props": {
      "id": "avisar",
      "label": "Notify the team",
      "defaultChecked": true
     }
    },
    "ms": {
     "type": "MultiSelectField",
     "props": {
      "id": "entornos",
