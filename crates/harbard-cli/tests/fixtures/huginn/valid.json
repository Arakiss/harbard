 {
  "name": "a filter, a repeat and a template",
  "view": {
   "root": "s",
   "state": {
    "env": "dev",
    "solo": false,
    "rows": [
     {
      "name": "api",
      "ok": true,
      "ms": 120
     },
     {
      "name": "web",
      "ok": false,
      "ms": 90
     }
    ]
   },
   "elements": {
    "s": {
     "type": "Stack",
     "props": {},
     "children": [
      "pick",
      "sw",
      "list",
      "note",
      "m",
      "pending"
     ]
    },
    "pick": {
     "type": "Segmented",
     "props": {
      "state": "/env",
      "label": "Environment",
      "options": [
       {
        "label": "Dev",
        "value": "dev"
       },
       {
        "label": "Prod",
        "value": "prod"
       }
      ]
     }
    },
    "sw": {
     "type": "Switch",
     "props": {
      "state": "/solo",
      "label": "Healthy only"
     }
    },
    "list": {
     "type": "Grid",
     "props": {
      "columns": 2
     },
     "children": [
      "row"
     ],
     "repeat": {
      "statePath": "/rows",
      "key": "name"
     },
     "visible": {
      "$or": [
       {
        "$state": "/solo",
        "eq": false
       },
       {
        "$item": "ok",
        "eq": true
       }
      ]
     }
    },
    "row": {
     "type": "Metric",
     "props": {
      "label": {
       "$item": "name"
      },
      "value": {
       "$template": "${ms} ms en ${/env}"
      }
     }
    },
    "note": {
     "type": "Callout",
     "props": {
      "tone": "warning",
      "text": "This is production."
     },
     "visible": {
      "$state": "/env",
      "eq": "prod"
     }
    },
    "m": {
     "type": "Text",
     "props": {
      "text": {
       "$cond": {
        "$state": "/solo",
        "eq": true
       },
       "$then": "Filtrado",
       "$else": {
        "$state": "/env"
       }
      }
     }
    },
    "pending": {
     "type": "Badge",
     "props": {
      "text": "pending"
     },
     "visible": [
      {
       "$state": "/env",
       "neq": "dev"
      },
      {
       "$state": "/solo",
       "not": true
      }
     ]
    }
   }
  }
 },
