 {
  "name": "a form with every field",
  "view": {
   "root": "f",
   "elements": {
    "f": {
     "type": "Form",
     "props": {
      "id": "ajustes",
      "title": "Deployment settings",
      "detail": "Tell me how to leave it.",
      "submitLabel": "Enviar ajustes"
     },
     "children": [
      "wrap"
     ]
    },
    "wrap": {
     "type": "Stack",
     "props": {
      "gap": "sm"
     },
     "children": [
      "t",
      "m",
      "n",
      "s",
      "r",
      "c",
      "ms",
      "d",
      "sl"
     ]
    },
    "t": {
     "type": "TextField",
     "props": {
      "id": "nombre",
      "label": "Name",
      "required": true,
      "placeholder": "Type here",
      "hint": "A short name"
     }
    },
    "m": {
     "type": "TextField",
     "props": {
      "id": "motivo",
      "label": "Reason",
      "multiline": true,
      "defaultValue": "Because"
     }
    },
    "n": {
     "type": "NumberField",
     "props": {
      "id": "replicas",
      "label": "Replicas",
      "min": 1,
      "max": 9,
      "step": 1,
